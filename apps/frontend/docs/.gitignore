# Auto-generated API documentation
# Ignore all auto-generated API docs but keep service overview pages
/content/docs/service/auth/*.mdx
!/content/docs/service/auth/index.mdx
/content/docs/service/auth/api/
/content/docs/service/mail/*.mdx
!/content/docs/service/mail/index.mdx
/content/docs/service/mail/api/
/content/docs/service/webhook/*.mdx
!/content/docs/service/webhook/index.mdx
/content/docs/service/webhook/api/
/content/docs/service/server/*.mdx
!/content/docs/service/server/index.mdx
/content/docs/service/server/api/
/content/docs/setup/backend/auth/*.mdx
!/content/docs/setup/backend/auth/index.mdx
/content/docs/setup/backend/auth/api/

