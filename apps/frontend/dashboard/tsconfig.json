{
	"extends": "@reloop/tsconfig/nextjs.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"#/*": ["./src/*"],
			"@/*": ["./src/*"],
			"@fe/dashboard": ["./src/*"],
			"@fe/dashboard/*": ["./src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"next.config.ts",
		"playwright.config.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"tests/**/*.ts",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules", "server"]
}
