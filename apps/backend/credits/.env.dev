# App
PORT=8023
NODE_ENV=development
INITIAL_CREDITS=100

# Messaging
NATS_URL=nats://localhost:4222
NODE_TLS_REJECT_UNAUTHORIZED=0

# Billing (Polar) — Cloud only; leave BILLING_ENABLED=false for self-host
BILLING_ENABLED=false
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
BILLING_SUCCESS_URL=https://local.reloop.sh/dashboard/settings/billing?checkout=success
BILLING_RETURN_URL=https://local.reloop.sh/dashboard/settings/billing

# OpenTelemetry (SigNoz) Logging
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS="signoz-access-token=your-token"
