# App
PORT=8023
NODE_ENV=production
INITIAL_CREDITS=100

# Messaging
NATS_URL= # [REQUIRED] NATS server connection string

# Billing (Polar) — Cloud only
BILLING_ENABLED=false
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production
BILLING_SUCCESS_URL=https://reloop.sh/dashboard/settings/billing?checkout=success
BILLING_RETURN_URL=https://reloop.sh/dashboard/settings/billing

# OpenTelemetry (SigNoz) Logging
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS="signoz-access-token=your-token"
