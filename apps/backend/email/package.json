{
	"name": "email",
	"version": "1.0.0",
	"private": true,
	"main": "src/index.ts",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./emails/*": "./emails/*",
		"./locales": "./locales/index.ts",
		"./render": "./render.ts"
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.js",
		"email:dev": "email dev -p 3005",
		"email:build": "email build",
		"email:start": "email start",
		"clean": "rm -rf .turbo node_modules dist"
	},
	"dependencies": {
		"@elysiajs/cors": "catalog:backend",
		"@elysiajs/openapi": "catalog:backend",
		"@react-email/render": "catalog:ui",
		"@react-email/tailwind": "catalog:ui",
		"@reloop/bus": "workspace:*",
		"@reloop/logger": "workspace:*",
		"date-fns": "catalog:backend",
		"elysia": "catalog:backend",
		"react": "catalog:ui",
		"react-dom": "catalog:ui",
		"react-email": "catalog:ui",
		"reloop-email": "catalog:backend"
	},
	"devDependencies": {
		"@react-email/ui": "catalog:ui",
		"@reloop/tsconfig": "workspace:*",
		"@types/bun": "catalog:backend",
		"tsdown": "catalog:backend",
		"typescript": "catalog:"
	}
}
