# App
PORT=8022
NODE_ENV=production
BASE_URL= # [REQUIRED] Public site origin for email links, e.g. https://reloop.sh

# Messaging
NATS_URL= # [REQUIRED] NATS server connection string

# Platform org API key — must own RELOOP_SENDER_DOMAIN
RELOOP_API_KEY= # [REQUIRED]

# System product mail From domain (auth, billing, invites, …)
RELOOP_SENDER_DOMAIN= # [REQUIRED] e.g. reloop.sh

# Onboarding “Send email” From domain (can differ; must also be owned by the API key org)
ONBOARDING_TEST_DOMAIN= # [REQUIRED] e.g. mail.reloop.sh

# OpenTelemetry (SigNoz) Logging
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS="signoz-access-token=your-token"
