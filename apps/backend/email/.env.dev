# App
EMAIL_PORT=8022
NODE_ENV=development
BASE_URL="https://local.reloop.sh"

# Messaging
NATS_URL=nats://localhost:4222
PORT=8022

# Platform org API key (owns RELOOP_SENDER_DOMAIN). Empty → Mailpit.
RELOOP_API_KEY=

# System product mail From domain
RELOOP_SENDER_DOMAIN=

# Onboarding “Send email” From domain (separate)
ONBOARDING_TEST_DOMAIN=

# OpenTelemetry (SigNoz) Logging
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS="signoz-access-token=your-token"
