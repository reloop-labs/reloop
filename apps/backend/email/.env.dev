# App
EMAIL_PORT=8022
NODE_ENV=development
BASE_URL="https://local.reloop.sh"

# Messaging
NATS_URL=nats://localhost:4222
PORT=8022

# Platform org API key (owns RELOOP_SENDER_DOMAIN).
# Empty, and with no SMTP_HOST below, development falls back to Mailpit.
RELOOP_API_KEY=

# System product mail From domain
RELOOP_SENDER_DOMAIN=local.reloop.sh

# Onboarding “Send email” From domain (separate)
ONBOARDING_TEST_DOMAIN=

# Relay system mail through your own SMTP server instead of Reloop.
# Takes effect only when RELOOP_API_KEY is empty. Required in production if
# you have no verified sending domain yet, since Mailpit is development-only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Where development mail is captured. Ignored when NODE_ENV=production.
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# OpenTelemetry (SigNoz) Logging
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS="signoz-access-token=your-token"
