# Database
PG_URL=    # [REQUIRED] PostgreSQL connection string
REDIS_URL= # [REQUIRED] Redis connection string

# App
PORT=8018
BASE_URL=  # [REQUIRED] Public URL of this service
NODE_ENV=production
# NODE_TLS_REJECT_UNAUTHORIZED=0

# S3 / Storage
S3_ENDPOINT= # [REQUIRED] S3 endpoint URL
S3_ACCESS_KEY= # [REQUIRED] S3 access key
S3_SECRET_KEY= # [REQUIRED] S3 secret key
S3_BUCKET= # [REQUIRED] S3 bucket name
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Messaging
NATS_URL=  # [REQUIRED] NATS server connection string
