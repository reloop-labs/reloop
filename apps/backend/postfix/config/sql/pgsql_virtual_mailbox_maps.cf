user = ${DB_USER}
password = ${DB_PASSWORD}
hosts = ${DB_HOST}
dbname = ${DB_NAME}

# Since we don't have mailbox table, generate mail_dir based on user email
# Format: /var/mail/domain/user/
query = SELECT CONCAT('/var/mail/', SPLIT_PART('%s', '@', 2), '/', SPLIT_PART('%s', '@', 1), '/') FROM "user" WHERE email='%s'
