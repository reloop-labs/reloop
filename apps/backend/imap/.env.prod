# Database
PG_URL=    # [REQUIRED] PostgreSQL connection string

# Messaging
NATS_URL=  # [REQUIRED] NATS server connection string

# IMAP
IMAP_ADDR=:143      # IMAP with STARTTLS
IMAP_TLS_ADDR=:993  # IMAPS (implicit TLS), what mail apps connect to
HEALTH_ADDR=:8029   # GET /health; keep internal
IMAP_TLS_CERT=  # [REQUIRED] Path to the certificate chain PEM (e.g. /certs/fullchain.pem)
IMAP_TLS_KEY=   # [REQUIRED] Path to the private key PEM (e.g. /certs/privkey.pem)
# IMAP_ALLOW_INSECURE_AUTH must stay unset in production.
