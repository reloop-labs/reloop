# Database
PG_URL=    # [REQUIRED] PostgreSQL connection string

# Messaging
NATS_URL=  # [REQUIRED] NATS server connection string

# IMAP
IMAP_HOSTNAME= # [REQUIRED] Public IMAP host customers enter in mail apps (e.g. imap.reloop.sh)

# TLS certificate: found automatically, like the SMTP service, in this order:
#   1. IMAP_TLS_CERT + IMAP_TLS_KEY (file paths) or IMAP_TLS_CERT_DATA + IMAP_TLS_KEY_DATA (PEM)
#   2. /certs/fullchain.pem + /certs/privkey.pem, /etc/letsencrypt/live/<IMAP_HOSTNAME>/
#   3. Coolify/Traefik acme.json: mount /data/coolify/proxy read-only
#   4. Caddy certificate store
#   5. AUTO_LETSENCRYPT=true: request from Let's Encrypt (needs port 80 free)
#   6. otherwise self-signed (mail apps will warn)
# Renewals are picked up every 5 minutes without a restart.
# IMAP_TLS_ACME_JSON=     # Custom acme.json path, checked first
# AUTO_LETSENCRYPT=false
# LETSENCRYPT_EMAIL=      # Defaults to admin@<IMAP_HOSTNAME>

# Ports default to :143 (STARTTLS), :993 (IMAPS) and :8029 (health); override with
# IMAP_ADDR, IMAP_TLS_ADDR, HEALTH_ADDR. Never set IMAP_ALLOW_INSECURE_AUTH in production.
