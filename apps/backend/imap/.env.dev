# Database
PG_URL=postgresql://reloop:reloop123@localhost:5432/reloop

# Messaging
NATS_URL=nats://localhost:4222

# Validates IMAP passwords (API keys) via the domain service's /v1/smtp-auth
DOMAIN_SERVICE_URL=http://localhost:8011/api/domain
RELOOP_INTERNAL_SECRET=reloop_internal_secret_default_123

# IMAP
IMAP_HOSTNAME=local.reloop.sh
IMAP_ADDR=:1143
IMAP_TLS_ADDR=:1993
HEALTH_ADDR=:8031
# No real certificate locally (a self-signed one is generated), so allow
# plain-text login on IMAP_ADDR. Never set this in production.
IMAP_ALLOW_INSECURE_AUTH=true
