# Database
PG_URL=    # [REQUIRED] PostgreSQL connection string
REDIS_URL= # [REQUIRED] Redis connection string

# App
PORT=8015
BASE_URL=  # [REQUIRED] Public URL of this service (e.g. https://reloop.sh)
# Public origin for /redirect + open pixels when no custom tracking domain.
# Must be the links app host (https://link.reloop.sh), not BASE_URL.
TRACKING_BASE_URL=https://link.reloop.sh
NODE_ENV=production

# Messaging
NATS_URL=  # [REQUIRED] NATS server connection string


KUMOMTA_HTTP_URL= # [REQUIRED] KumoMTA HTTP API URL
RELOOP_INTERNAL_SECRET= # [REQUIRED] Shared secret for internal service auth

# OpenTelemetry (SigNoz) Logging
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS="signoz-access-token=your-token"
