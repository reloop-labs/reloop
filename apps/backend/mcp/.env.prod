# App
HOST=0.0.0.0
PORT=8029
RELOOP_BASE_URL=  # [REQUIRED] Public URL of the Reloop instance
NODE_ENV=production
# NODE_TLS_REJECT_UNAUTHORIZED=0

# MCP Settings
# MCP_ALLOWED_HOSTS= # Host header allowlist; defaults to * (any host)
# RELOOP_MCP_RESOURCE= # Defaults to <RELOOP_BASE_URL>/mcp; must match auth MCP_RESOURCE
# RELOOP_AUTH_ISSUER=  # Defaults to <RELOOP_BASE_URL>/api/auth/v1
