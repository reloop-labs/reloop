{
	"name": "reloop-mcp",
	"version": "0.1.0",
	"description": "The official MCP server for Reloop — open-source email infrastructure",
	"type": "module",
	"license": "Apache-2.0",
	"author": "Reloop Labs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reloop-labs/reloop-mcp.git"
	},
	"homepage": "https://github.com/reloop-labs/reloop-mcp#readme",
	"bugs": {
		"url": "https://github.com/reloop-labs/reloop-mcp/issues"
	},
	"keywords": [
		"reloop",
		"mcp",
		"model-context-protocol",
		"email",
		"contacts",
		"transactional-email"
	],
	"bin": {
		"reloop-mcp": "dist/cli.js"
	},
	"main": "dist/lib.js",
	"types": "dist/types/src/lib.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/src/lib.d.ts",
			"import": "./dist/lib.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun src/cli.ts --transport stdio",
		"dev:http": "bun --watch src/cli.ts --transport http",
		"build": "bun run build:cli && bun run build:lib && bun run build:types",
		"build:cli": "bun build src/cli.ts --outfile dist/cli.js --target node --format esm --packages external --banner '#!/usr/bin/env node'",
		"build:lib": "bun build src/lib.ts --outfile dist/lib.js --target node --format esm --packages external",
		"build:types": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "2.0.0",
		"zod": "^4.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.6",
		"@modelcontextprotocol/client": "2.0.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^20.0.0",
		"typescript": "^5.9.2"
	}
}
