# Database
PG_URL=    # [REQUIRED] PostgreSQL connection string
REDIS_URL= # [REQUIRED] Redis connection string

# App
PORT=8011
BASE_URL=  # [REQUIRED] Public URL of this service
NODE_ENV=production
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Domain Settings
HOST_DOMAIN= # [REQUIRED] Main domain name
DKIM_SELECTOR=reloop

# Messaging
NATS_URL=  # [REQUIRED] NATS server connection string
RELOOP_INTERNAL_SECRET= # [REQUIRED] Shared secret for internal service auth



# OpenTelemetry (SigNoz) Logging
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS="signoz-access-token=your-token"

#Domain Connect signing private key
DOMAIN_CONNECT_SIGNING_PRIVATE_KEY=
