# Database
PG_URL=    # [REQUIRED] PostgreSQL connection string
REDIS_URL= # [REQUIRED] Redis connection string

# App
PORT=8014
BASE_URL=  # [REQUIRED] Public URL of this service
NODE_ENV=production
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Messaging
NATS_URL=  # [REQUIRED] NATS server connection string

PREFERENCES_SECRET=

# OpenTelemetry (SigNoz) Logging
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS="signoz-access-token=your-token"
