driver = pgsql
connect = host=reloop-postgres dbname=reloop user=reloop password=reloop123

default_pass_scheme = PLAIN

# User query - generate mail directory based on user email
# Since we don't have a mailbox table, use user table
user_query = SELECT CONCAT('/var/mail/', SPLIT_PART(email, '@', 2), '/', SPLIT_PART(email, '@', 1)) as home, CONCAT('maildir:/var/mail/', SPLIT_PART(email, '@', 2), '/', SPLIT_PART(email, '@', 1)) as mail, 5000 AS uid, 5000 AS gid FROM "user" WHERE email = '%u'

# Password query - authenticate against user table
# Note: This requires password field in user table or better-auth account table
password_query = SELECT email as user, password, CONCAT('/var/mail/', SPLIT_PART(email, '@', 2), '/', SPLIT_PART(email, '@', 1)) as userdb_home, CONCAT('maildir:/var/mail/', SPLIT_PART(email, '@', 2), '/', SPLIT_PART(email, '@', 1)) as userdb_mail, 5000 as userdb_uid, 5000 as userdb_gid FROM account WHERE provider_id = 'credential' AND EXISTS (SELECT 1 FROM "user" WHERE "user".id = account.user_id AND "user".email = '%u')
