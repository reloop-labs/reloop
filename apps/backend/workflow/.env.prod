# Database
PG_URL=    # [REQUIRED] PostgreSQL connection string
REDIS_URL= # [REQUIRED] Redis connection string

# App
PORT=8017           # [OPTIONAL] Server port (default: 8017)
BASE_URL=           # [REQUIRED] Public URL of this service
NODE_ENV=production # production | development
# NODE_TLS_REJECT_UNAUTHORIZED=0 # [OPTIONAL] Disable SSL check for internal connections

# Messaging
NATS_URL= # [REQUIRED] NATS server connection string
