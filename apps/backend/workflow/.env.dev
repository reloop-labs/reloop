# Database
PG_URL=postgresql://reloop:reloop123@localhost:5432/reloop
REDIS_URL=redis://:reloop123@localhost:6379

# App
PORT=8017
BASE_URL="https://local.reloop.sh"
NODE_ENV=development
NODE_TLS_REJECT_UNAUTHORIZED=0

# Messaging
NATS_URL=nats://localhost:4222

# Internal service auth (mail send from automation steps)
RELOOP_INTERNAL_SECRET=reloop_internal_secret_default_123

# OpenTelemetry (SigNoz) Logging
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS="signoz-access-token=your-token"

# Optional basic-auth for Workbench dashboard (/api/workflow/jobs)
# WORKBENCH_USER=admin
# WORKBENCH_PASS=secret
