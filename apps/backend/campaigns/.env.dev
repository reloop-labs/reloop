# Database
PG_URL=postgresql://reloop:reloop123@localhost:5432/reloop
REDIS_URL=redis://:reloop123@localhost:6379

# App
PORT=8027
BASE_URL="https://local.reloop.sh"
NODE_ENV=development
NODE_TLS_REJECT_UNAUTHORIZED=0

# Messaging
NATS_URL=nats://localhost:4222

# Unsubscribe tokens — must match PREFERENCES_SECRET in the contacts service.
PREFERENCES_SECRET="reloop-preferences-secret-key-change-in-prod"
# Links-app fallback for unsubscribe URLs when the sender domain has no
# custom tracking domain.
TRACKING_BASE_URL="https://local.reloop.sh"
