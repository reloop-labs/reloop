# Database
PG_URL=    # [REQUIRED] PostgreSQL connection string
REDIS_URL= # [REQUIRED] Redis connection string

# Auth
BETTER_AUTH_SECRET= # [REQUIRED] Random 32-char string (e.g. openssl rand -hex 32)
BASE_URL=           # [REQUIRED] Public site origin, e.g. https://reloop.sh (NOT local.reloop.sh)
NODE_ENV=production # production | development
PORT=8000           # [OPTIONAL] Server port (default: 8000)
# NODE_TLS_REJECT_UNAUTHORIZED=0 # [OPTIONAL] Disable SSL check for internal connections

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Messaging
NATS_URL= # [REQUIRED] NATS server connection string

# Misc
DEFAULT_OTP=888888   # For initial self-host setup; remove/change after first login
DISABLE_SIGNUP=false # Set 'true' to disable signups after creating your account

# OpenTelemetry (SigNoz) Logging
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS="signoz-access-token=your-token"
