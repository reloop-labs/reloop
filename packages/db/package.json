{
	"name": "@reloop/db",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./schema": "./src/schema/index.ts",
		"./index": "./src/index.ts",
		"./reserve-send-credits": "./src/reserve-send-credits.ts",
		"./billing-period": "./src/billing-period.ts",
		"./inbox-plan-cap": "./src/inbox-plan-cap.ts",
		"./self-hosted": "./src/self-hosted.ts",
		"./domain-age-cap": "./src/domain-age-cap.ts",
		"./smtp-recipients": "./src/smtp-recipients.ts",
		"./html-to-text": "./src/html-to-text.ts",
		"./outbound-abuse": "./src/outbound-abuse.ts",
		"./reputation": "./src/reputation.ts",
		"./spam-check": "./src/spam-check.ts",
		"./sender-gate": "./src/sender-gate.ts",
		"./domain-risk": "./src/domain-risk.ts",
		"./ensure-sending-domain-verified": "./src/ensure-sending-domain-verified.ts",
		"./spamhaus-dbl": "./src/spamhaus-dbl.ts",
		"./webhook-events": "./src/webhook-events.ts",
		"./utils": "./src/utils/*"
	},
	"scripts": {
		"build": "tsc --build",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc --build tsconfig.package.json",
		"env:copy-example": "shx -- cp -n .env.dev .env",
		"env:remove": "shx -- rm -f .env",
		"env:run": "dotenv --",
		"push": "bun env:run drizzle-kit push",
		"studio": "bun env:run drizzle-kit studio",
		"typecheck": "tsc --build --noEmit --emitDeclarationOnly false",
		"db:generate": "bun env:run drizzle-kit generate",
		"db:migrate": "bun env:run drizzle-kit migrate",
		"db:push": "bun env:run drizzle-kit push",
		"db:studio": "bun env:run drizzle-kit studio",
		"db:seed": "bun env:run bun run src/utils/seed.ts",
		"db:reset": "bun env:run bun src/reset.ts",
		"migrate": "bun run src/migrate.ts"
	},
	"dependencies": {
		"@reloop/dns": "workspace:*",
		"@reloop/webhook-events": "workspace:*",
		"drizzle-orm": "catalog:db",
		"drizzle-typebox": "catalog:db",
		"html-to-text": "catalog:backend",
		"pg": "catalog:db",
		"redis": "catalog:db",
		"@paralleldrive/cuid2": "catalog:backend",
		"tldts": "^7.4.11"
	},
	"devDependencies": {
		"@reloop/tsconfig": "workspace:*",
		"@types/html-to-text": "catalog:backend",
		"@types/node": "catalog:",
		"@types/pg": "catalog:db",
		"dotenv-cli": "catalog:db",
		"drizzle-kit": "catalog:db",
		"shx": "catalog:db",
		"typescript": "catalog:"
	}
}
