{
	"name": "@config",
	"private": true,
	"type": "module",
	"exports": {
		"./app": {
			"types": "./dist/src/app.d.ts",
			"default": "./src/app.ts"
		},
		"./database": {
			"types": "./dist/src/database.d.ts",
			"default": "./src/database.ts"
		},
		"./mail": {
			"types": "./dist/src/mail.d.ts",
			"default": "./src/mail.ts"
		}
	},
	"scripts": {
		"build": "tsc --build",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc --build tsconfig.package.json",
		"typecheck": "tsc --build --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {},
	"devDependencies": {
		"@ts": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
