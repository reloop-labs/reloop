{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Next.js",
	"extends": "./base.json",
	"compilerOptions": {
		"plugins": [{ "name": "next" }],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowJs": true,
		"jsx": "preserve",
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@reloop/ui": ["../../packages/ui/src/*"],
			"@reloop/auth": ["../../packages/auth/src/*"],
			"@reloop/db": ["../../packages/db/src/*"],
			"@reloop/cache": ["../../packages/cache/src/*"],
			"@reloop/webhook-events": ["../../packages/webhook-events/src/index.ts"],
			"@reloop/webhook-events/*": ["../../packages/webhook-events/src/*"],
			"@reloop/apikey": ["../../packages/apikey/src/index.ts"],
			"@reloop/template": ["../../apps/backend/template/src/*"],
			"@be/workflow": ["../../apps/backend/workflow/src/*"],
			"@reloop/webhook": ["../../apps/backend/webhook/src/*"],
			"@reloop/audience": ["../../apps/backend/audience/src/*"],
			"@reloop/be-mail": ["../../apps/backend/mail/src/*"],
			"@reloop/email": ["../../apps/backend/email/index.ts"],
			"@reloop/logs": ["../../apps/backend/logs/src/*"],
			"@fe/dashboard": ["../../apps/frontend/dashboard/src/*"],
			"@be/domain": ["../../apps/backend/domain/src/*"],
			"@be/domain/*": ["../../apps/backend/domain/src/*"],
			"@fe/web": ["../../apps/frontend/web/src/*"],
			"@fe/docs": ["../../apps/frontend/docs/src/*"]
		}
	}
}
