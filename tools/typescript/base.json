{
	"compilerOptions": {
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "ES2022",
		"lib": ["ES2022"],
		"allowJs": true,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,

		"incremental": true,
		"disableSourceOfProjectReferenceRedirect": true,
		"tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.json",

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"checkJs": true,

		"module": "es2022",
		"moduleResolution": "bundler",
		"noEmit": true,
		"baseUrl": "../../",
		"paths": {
			"@web/*": ["apps/web/src/*"],
			"@web/public/*": ["apps/web/public/*"],
			"@web/components": ["apps/web/src/components/index.ts"],
			"@web/layouts": ["apps/web/app/src/layouts/index.ts"],
			"@web/stores": ["apps/web/app/src/stores/index.ts"],
			"@web/libs": ["apps/web/app/src/libs/index.ts"],
			"@api": ["apps/api/src/index.ts"],
			"@api/*": ["apps/api/src/*"],
			"@libs": ["packages/libs/src/index.ts"],
			"@libs/*": ["packages/libs/src/*"],
			"@ui/*": ["packages/ui/src/*"]
		}
	},
	"exclude": ["node_modules", "build", "dist"]
}
