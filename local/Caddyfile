reloop.local {
    # API service (running locally on port 3002)
    handle /dev* {
        reverse_proxy host.docker.internal:3004 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
        }
    }
    handle /api/auth* {
        reverse_proxy host.docker.internal:3010 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
        }
    }
    handle /api/mail* {
        reverse_proxy host.docker.internal:3009 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
        }
    }
    handle /api/domain* {
        reverse_proxy host.docker.internal:3011 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
        }
    }
    handle /dashboard* {
        reverse_proxy host.docker.internal:3001 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
        }
    }

    # Main app (running locally - everything else)
    handle {
        reverse_proxy host.docker.internal:3000 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
        }
    }
}
